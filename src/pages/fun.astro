---
import Layout from '../layouts/Layout.astro';
import EasterEggs from '../components/EasterEggs.astro';
import QuoteNotification from '../components/QuoteNotification.astro';

const interests = [
  { label: 'Playing', detail: 'Red Dead Redemption 2, Spider-Man, and puzzle or strategy games on my phone.' },
  { label: 'Reading', detail: 'Tech blogs, sci-fi, and the odd philosophy book.' },
  { label: 'Watching', detail: 'Sci-fi, thrillers, anime.' },
  { label: 'Listening', detail: 'Lo-fi, ambient and synthwave, mostly while I work.' },
  { label: 'Also', detail: 'Anything about space, cooking experiments, short trips, and getting back into regular workouts.' },
];

const miscPages = [
  { href: '/meme', label: 'Memes' },
  { href: '/random', label: 'Random notes' },
  { href: '/guestbook', label: 'Guestbook' },
  { href: '/credits', label: 'Credits' },
];

let visitorCount: string | null = null;
try {
  const apiKey = import.meta.env.GOATCOUNTER_API_KEY;
  if (apiKey) {
    const res = await fetch('https://mangeshbide.goatcounter.com/api/v0/stats/total?start=2020-01-01T00:00:00Z&end=2030-01-01T00:00:00Z', {
      headers: {
        'Authorization': `Bearer ${apiKey}`,
        'Content-Type': 'application/json',
      },
    });
    if (res.ok) {
      const data = await res.json();
      visitorCount = new Intl.NumberFormat().format(data.total ?? 0);
    }
  }
} catch { /* silent fail — no counter shown */ }
---

<Layout title="Outside work | Mangesh Bide" description="What Mangesh Bide does outside work: games, sci-fi, music and space.">
  <div class="max-w-2xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-3">Outside work</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-10">The non-work part, briefly.</p>

    <dl class="space-y-5 mb-12">
      {interests.map(({ label, detail }) => (
        <div class="grid sm:grid-cols-[7rem_1fr] gap-1 sm:gap-4">
          <dt class="font-mono text-sm text-gray-500 dark:text-gray-400 sm:pt-0.5">{label}</dt>
          <dd class="text-gray-800 dark:text-gray-200">{detail}</dd>
        </div>
      ))}
    </dl>

    <h2 class="font-mono text-sm text-gray-500 dark:text-gray-400 mb-3">Also on this site</h2>
    <ul class="flex flex-wrap gap-x-5 gap-y-2 mb-16">
      {miscPages.map(({ href, label }) => (
        <li>
          <a href={href} class="underline underline-offset-4 decoration-gray-300 dark:decoration-gray-600 hover:text-emerald-700 dark:hover:text-cyan-400 transition-colors">{label}</a>
        </li>
      ))}
    </ul>

    <div class="text-xs text-gray-500 dark:text-gray-400">
      {visitorCount && <p>{visitorCount} visitors and counting</p>}
      <p class="mt-2 opacity-50 hover:opacity-100 transition-opacity">
        <span class="cursor-help footer-float" title="Curious minds might find something interesting...">👀</span>
        <a href="/secret" class="text-gray-400 hover:text-blue-400 transition-colors ml-1 link-glow">.</a>
      </p>
    </div>
  </div>

  <EasterEggs />
  <QuoteNotification />
</Layout>
