---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { getPublishedPosts } from "../utils/published-posts";
import { Image } from "astro:assets";
import meImage from "../assets/me.jpg";
import { identity } from "../data/identity";
import resume from "../data/resume.json";

const title = `${identity.name} | ${identity.headline}`;

// Pinned, not newest-first: these posts back the work the resume leads with.
const allPosts = await getPublishedPosts();
const pinnedPosts = [
  "building-mira-voice-agent",
  "multi-tenant-architecture-complete-guide",
  "hipaa-guardian-ai-skills-healthcare",
  "pgbouncer-connection-pooling",
].map((id) => {
  const post = allPosts.find((p) => p.id === id);
  if (!post) throw new Error(`pinned post "${id}" is missing or unpublished`);
  return post;
});

// Selected Work mirrors the resume's project list, in the same order.
const allProjects = await getCollection("portfolio");
const projectsToShow = resume.projects.map((p) => {
  const entry = allProjects.find((e) => e.id === p.portfolio);
  if (!entry) throw new Error(`resume.json project "${p.name}" has no portfolio entry "${p.portfolio}"`);
  return entry;
});

// Each highlight quotes its figure from an experience bullet, so the hero and the resume cannot disagree.
const experienceText = resume.experience.flatMap((job) => job.bullets).join(" ");
for (const { figure } of resume.highlights) {
  if (!experienceText.includes(figure)) throw new Error(`resume.json highlight "${figure}" is not in any experience bullet`);
}

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(new Date(date));
};

const sectionLink = "text-emerald-700 dark:text-emerald-400 hover:underline text-sm font-medium whitespace-nowrap";
const textLink = "font-medium text-emerald-700 dark:text-emerald-400 hover:underline";
---

<Layout title={title}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <!-- Hero Section -->
    <div class="mb-20 lg:grid lg:grid-cols-[minmax(0,1fr)_17.5rem] lg:gap-12">
      <div>
        <div class="flex items-center gap-4">
          <Image
            src={meImage}
            alt="Mangesh Bide"
            width={128}
            height={128}
            fetchpriority="high"
            loading="eager"
            class="w-16 h-16 flex-none rounded-full object-cover"
          />
          <div>
            <h1 class="text-xl font-semibold leading-tight">Mangesh Bide</h1>
            <p class="text-gray-700 dark:text-gray-300">{identity.headline}</p>
          </div>
        </div>

        <p class="mt-8 text-[2rem] sm:text-[2.5rem] font-semibold leading-[1.14] tracking-tight text-pretty">
          {identity.tagline}
        </p>
        <p class="mt-6 text-lg text-gray-600 dark:text-gray-400 leading-relaxed">
          I led a greenfield authentication and authorization platform from
          architecture through production deployment. It uses self-hosted Keycloak with custom Java
          SPIs, multi-tenant SSO with IdP federation, and SpiceDB-based ReBAC. On my own time I build
          voice and agentic AI projects like Mira and Fieldnotes.
        </p>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-3 mt-8">
          <a
            href="/resume/"
            class="inline-flex items-center px-5 py-2.5 rounded-lg bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 font-medium hover:opacity-90 transition-opacity"
          >
            Resume
          </a>
          <a
            href="mailto:hello@mangeshbide.tech"
            class="inline-flex items-center px-5 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
          >
            hello@mangeshbide.tech
          </a>
          <div class="flex gap-x-5">
            <a href="https://linkedin.com/in/mangesh-bide/" class={textLink}>LinkedIn</a>
            <a href="https://github.com/1mangesh1" class={textLink}>GitHub</a>
            <a href="https://x.com/Mangesh_Bide" class={textLink}>X</a>
          </div>
        </div>
      </div>

      <aside class="mt-12 lg:mt-1">
        <h2 class="text-sm font-medium text-gray-500 dark:text-gray-400">
          Software Development Engineer I at {identity.employer} · {identity.location}
        </h2>
        <ul class="mt-4 border-t border-gray-200 dark:border-gray-800 divide-y divide-gray-200 dark:divide-gray-800">
          {
            resume.highlights.map(({ figure, label }) => (
              <li class="py-4">
                <strong class="block font-semibold">{figure}</strong>
                <span class="block mt-1 text-sm text-gray-600 dark:text-gray-400">{label}</span>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>

    <!-- Selected Work -->
    <div class="mb-20">
      <div class="flex justify-between items-baseline gap-4 mb-6">
        <h2 class="text-2xl font-bold tracking-tight">Selected Work</h2>
        <a href="/portfolio/" class={sectionLink}>View all work</a>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {projectsToShow.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>

    <!-- Featured Blog Posts -->
    <div class="mb-20">
      <div class="flex justify-between items-baseline gap-4 mb-2">
        <h2 class="text-2xl font-bold tracking-tight">Selected Writing</h2>
        <a href="/blog/" class={sectionLink}>View all posts</a>
      </div>

      <ul class="divide-y divide-gray-200 dark:divide-gray-800">
        {
          pinnedPosts.map((post) => (
            <li class="animate-on-scroll">
              <a href={`/blog/${post.id}/`} class="group block py-5">
                <time datetime={post.data.pubDate.toISOString()} class="text-sm text-gray-500 dark:text-gray-400">
                  {formatDate(post.data.pubDate)}
                </time>
                <h3 class="text-lg font-semibold mt-1 group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">
                  {post.data.title}
                </h3>
                <p class="text-gray-600 dark:text-gray-400 mt-1 line-clamp-2">
                  {post.data.description}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- About Section / Philosophy -->
    <div class="mb-16">
      <h2 class="text-2xl font-bold tracking-tight mb-6">What I work with</h2>
      <div class="grid md:grid-cols-3 gap-x-8 gap-y-6" data-stagger>
        <div class="animate-on-scroll border-t border-gray-200 dark:border-gray-800 pt-4">
          <h3 class="font-semibold mb-1">Backend &amp; APIs</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            Python, Django, FastAPI, and PostgreSQL: auth, data modeling, and
            APIs built to hold up in production.
          </p>
        </div>
        <div class="animate-on-scroll border-t border-gray-200 dark:border-gray-800 pt-4">
          <h3 class="font-semibold mb-1">Applied AI &amp; Agents</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            LLM applications, RAG pipelines, and tool-calling agents: wiring
            models into products that do real work.
          </p>
        </div>
        <div class="animate-on-scroll border-t border-gray-200 dark:border-gray-800 pt-4">
          <h3 class="font-semibold mb-1">Infrastructure &amp; Cloud</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            Terraform and Docker on AWS, plus a k3s homelab on OCI: reproducible
            infra and CI/CD from zero.
          </p>
        </div>
      </div>
    </div>

    <div class="animate-on-scroll mb-16 max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight mb-3">Why this site exists</h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed">
        I learn things by building the smallest version that actually runs. Then I
        write down what broke. This site is where both halves end up: the projects
        and the post-mortems. If it saves you an afternoon, even better.
      </p>
    </div>

    <!-- GitHub Activity. The chart is a third-party image: if it fails to load, the section removes itself. -->
    <div class="mb-16 animate-on-scroll" id="github-activity">
      <h2 class="font-semibold mb-3">GitHub Activity</h2>
      <a
        href="https://github.com/1mangesh1"
        target="_blank"
        rel="noopener noreferrer"
        class="block w-full overflow-hidden hover:opacity-90 transition-opacity"
      >
        <img
          src="https://ghchart.rshah.org/1mangesh1"
          alt="Mangesh's GitHub Contributions"
          class="w-full dark:hidden rounded-lg mx-auto"
          loading="lazy"
          onerror="document.getElementById('github-activity')?.remove()"
        />
        <img
          src="https://ghchart.rshah.org/1mangesh1"
          alt="Mangesh's GitHub Contributions"
          class="w-full hidden dark:block rounded-lg mx-auto"
          style="filter: invert(1) hue-rotate(180deg);"
          loading="lazy"
          onerror="document.getElementById('github-activity')?.remove()"
        />
      </a>
    </div>

    <!-- Playground -->
    <div class="pt-12 border-t border-gray-200 dark:border-gray-800">
      <div class="flex justify-between items-baseline gap-4 mb-2">
        <h2 class="text-2xl font-bold tracking-tight animate-on-scroll">Playground</h2>
        <a href="/playground/" class={sectionLink}>See all experiments</a>
      </div>
      <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-2xl animate-on-scroll">
        Not everything needs to be a product. These run in your browser right now.
      </p>

      <div class="grid gap-6 md:grid-cols-3" data-stagger>
        <a
          href="/wall/"
          class="bg-gray-50 dark:bg-gray-800/80 rounded-lg p-6 border border-gray-200 dark:border-gray-700 hover:border-emerald-300 dark:hover:border-emerald-700 hover-lift transition-all group card-animate animate-on-scroll shadow-sm"
        >
          <h3 class="font-semibold mb-2 group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">The Wall</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 m-0">
            A shared 64x64 canvas. One pixel per visitor every ten minutes.
          </p>
        </a>
        <a
          href="/earth-observatory/"
          class="bg-gray-50 dark:bg-gray-800/80 rounded-lg p-6 border border-gray-200 dark:border-gray-700 hover:border-emerald-300 dark:hover:border-emerald-700 hover-lift transition-all group card-animate animate-on-scroll shadow-sm"
        >
          <h3 class="font-semibold mb-2 group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">Earth Observatory</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 m-0">
            A 3D globe of live wildfires and storms, straight from NASA&rsquo;s EONET feed.
          </p>
        </a>
        <a
          href="/terminal/"
          class="bg-gray-50 dark:bg-gray-800/80 rounded-lg p-6 border border-gray-200 dark:border-gray-700 hover:border-emerald-300 dark:hover:border-emerald-700 hover-lift transition-all group card-animate animate-on-scroll shadow-sm"
        >
          <h3 class="font-semibold mb-2 group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">Terminal</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 m-0">
            This whole site behind a command line. Type <code>help</code>.
          </p>
        </a>
      </div>

      <!-- Call to Action & Quick Links -->
      <div class="mt-20 animate-on-scroll">
        <h2 class="text-2xl font-bold tracking-tight mb-2">Say hi</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-6">
          Got a question, idea, or just want to chat? I am around.
        </p>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
          <a
            href="/contact/"
            class="inline-block px-6 py-2.5 rounded-lg bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 text-base font-medium hover:opacity-90 transition-opacity"
          >
            Get In Touch
          </a>
          <a
            href="/rss.xml"
            class="text-gray-600 dark:text-gray-400 hover:text-emerald-700 dark:hover:text-emerald-400 flex items-center transition-colors"
          >
            <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path
                d="M3.429 2.4A17.5 17.5 0 0118 18h-2.5a15 15 0 00-15-15v-2.5zM3.429 7.9A7.5 7.5 0 0111 15.5H8.5a5 5 0 00-5-5V7.9zM6.4 13.6a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"
              ></path>
            </svg>
            RSS Feed
          </a>
          <a
            href="/search/"
            class="text-gray-600 dark:text-gray-400 hover:text-emerald-700 dark:hover:text-emerald-400 flex items-center transition-colors"
          >
            <svg
              class="w-4 h-4 mr-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            Search
          </a>
          <a
            href="/resume/"
            class="text-gray-600 dark:text-gray-400 hover:text-emerald-700 dark:hover:text-emerald-400 flex items-center transition-colors"
          >
            <svg
              class="w-4 h-4 mr-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
            Resume
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
