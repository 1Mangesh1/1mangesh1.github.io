---
import Layout from '../layouts/Layout.astro';
import { identity } from '../data/identity';
import resume from '../data/resume.json';

// Unfinished facts carry a TODO(mangesh) marker: visible as a warning in dev,
// dropped from production builds so a placeholder can never ship.
const isTodo = (s: string) => s.includes('TODO(mangesh)');
const shown = (s: string) => !(import.meta.env.PROD && isTodo(s));
const todoClass = 'text-amber-800 dark:text-amber-300 bg-amber-50 dark:bg-amber-900/30 rounded px-1';

const skillColors = [
  'text-blue-600 dark:text-blue-400',
  'text-red-600 dark:text-red-400',
  'text-green-700 dark:text-green-400',
  'text-cyan-700 dark:text-cyan-400',
  'text-orange-700 dark:text-orange-400',
  'text-purple-600 dark:text-purple-400',
];
const chipColors = [
  'bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200',
  'bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200',
  'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200',
];
const certifications = resume.certifications.filter((c) => shown(c.year));
---

<Layout title="Resume | Mangesh Bide" description={`Resume of ${identity.name}, ${identity.headline} at ${identity.employer}.`}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4">{identity.name}</h1>
      <p class="text-xl text-gray-600 dark:text-gray-400 mb-4">{identity.headline}</p>
      <div class="flex justify-center flex-wrap gap-x-5 gap-y-2 text-sm">
        <a href={`mailto:${identity.email}`} class="text-blue-600 dark:text-blue-400 hover:underline">
          {identity.email}
        </a>
        <a href={identity.links.linkedin} class="text-blue-600 dark:text-blue-400 hover:underline">
          LinkedIn
        </a>
        <a href={identity.links.github} class="text-blue-600 dark:text-blue-400 hover:underline">
          GitHub
        </a>
        <a href={identity.links.site} class="text-blue-600 dark:text-blue-400 hover:underline">
          mangeshbide.tech
        </a>
      </div>

      <div class="mt-6">
        <a
          href="/Resume.pdf"
          class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
          download="Mangesh_Bide_Resume.pdf"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          Download PDF
        </a>
      </div>
    </div>

    <div class="space-y-12">
      {shown(resume.summary) && (
        <section>
          <h2 class="text-2xl font-bold mb-4 border-b border-gray-200 dark:border-gray-700 pb-2">Summary</h2>
          <p class:list={['text-gray-700 dark:text-gray-300 leading-relaxed', isTodo(resume.summary) && todoClass]}>
            {resume.summary}
          </p>
        </section>
      )}

      <section>
        <h2 class="text-2xl font-bold mb-6 border-b border-gray-200 dark:border-gray-700 pb-2">Experience</h2>
        <div class="space-y-8">
          {resume.experience.map((job) => (
            <div class="relative pl-8 border-l-2 border-blue-200 dark:border-blue-800">
              <div class="absolute -left-2 top-0 w-4 h-4 bg-blue-500 rounded-full"></div>
              <div class="mb-1">
                {job.roles.map((role, i) => (
                  <div class={i > 0 ? 'mt-1' : ''}>
                    <h3 class={i === 0 ? 'text-xl font-semibold' : 'text-base font-medium text-gray-700 dark:text-gray-300'}>{role.title}</h3>
                    <p class="text-sm text-gray-500">{role.start} – {role.end}</p>
                  </div>
                ))}
                <p class="text-blue-600 dark:text-blue-400 font-medium mt-1">{job.org}, {job.location}</p>
              </div>
              <ul class="mt-3 space-y-2 text-gray-700 dark:text-gray-300">
                {job.bullets.filter(shown).map((b) => (
                  <li class:list={[isTodo(b) && todoClass]}>• {b}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-6 border-b border-gray-200 dark:border-gray-700 pb-2">Education</h2>
        <div class="space-y-4">
          {resume.education.map((ed) => (
            <div class="bg-gray-50 dark:bg-gray-800 p-6 rounded-lg">
              <h3 class="text-xl font-semibold mb-2">{ed.degree}</h3>
              <p class="text-blue-600 dark:text-blue-400 font-medium">{ed.school}</p>
              <p class="text-sm text-gray-500 mb-3">{ed.years}</p>
              <p class="text-gray-700 dark:text-gray-300">{ed.grade}</p>
            </div>
          ))}
        </div>
      </section>

      {certifications.length > 0 && (
        <section>
          <h2 class="text-2xl font-bold mb-6 border-b border-gray-200 dark:border-gray-700 pb-2">Certifications</h2>
          <ul class="space-y-2 text-gray-700 dark:text-gray-300">
            {certifications.map((c) => (
              <li>
                • <span class="font-medium">{c.name}</span>, {c.issuer},{' '}
                <span class:list={[isTodo(c.year) && todoClass]}>{c.year}</span>
                {c.verifyUrl && <a href={c.verifyUrl} class="ml-2 text-blue-600 dark:text-blue-400 hover:underline">Verify</a>}
              </li>
            ))}
          </ul>
        </section>
      )}

      <section>
        <h2 class="text-2xl font-bold mb-6 border-b border-gray-200 dark:border-gray-700 pb-2">Technical Skills</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {Object.entries(resume.skills).map(([category, items], i) => (
            <div class="bg-gray-50 dark:bg-gray-800 p-6 rounded-lg">
              <h3 class:list={['font-semibold text-lg mb-3', skillColors[i % skillColors.length]]}>{category}</h3>
              <ul class="space-y-1 text-sm">
                {items.map((item) => <li>• {item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-6 border-b border-gray-200 dark:border-gray-700 pb-2">Key Projects</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {resume.projects.map((p, i) => (
            <a href={`/portfolio/${p.portfolio}`} class="block bg-gray-50 dark:bg-gray-800 p-6 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
              <h3 class="font-semibold text-lg mb-2">{p.name}</h3>
              {p.bullets.filter(shown).map((b) => (
                <p class:list={['text-gray-600 dark:text-gray-400 text-sm mb-3', isTodo(b) && todoClass]}>{b}</p>
              ))}
              <div class="flex flex-wrap gap-2 mb-3">
                {p.stack.map((s) => (
                  <span class:list={['px-2 py-1 text-xs rounded', chipColors[i % chipColors.length]]}>{s}</span>
                ))}
              </div>
            </a>
          ))}
        </div>

        <div class="mt-8 text-center">
          <a
            href="/portfolio"
            class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
          >
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            View All Projects
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>
