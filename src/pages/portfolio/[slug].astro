---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const portfolioItems = await getCollection('portfolio');

  return portfolioItems.map((item) => {
    return {
      params: { slug: item.id },
      props: { item }
    };
  });
}

const { item } = Astro.props;
const { Content } = await render(item);
const { image, imageDark } = item.data;

const status = {
  live: { label: 'Live', class: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300' },
  wip: { label: 'In progress', class: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300' },
  archived: { label: 'Archived', class: 'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300' },
}[item.data.status];

// Stars/forks are third-party signal, so they are worth showing — but only if
// current. Fetched at build time (the site rebuilds weekly) rather than pinned
// to a number in frontmatter that silently goes stale.
let repoStats: { stars: number; forks: number } | null = null;
const repoPath = item.data.github?.match(/github\.com\/([^/]+\/[^/]+?)(?:\.git)?\/?$/)?.[1];
if (repoPath) {
  try {
    const token = import.meta.env.GITHUB_TOKEN;
    const res = await fetch(`https://api.github.com/repos/${repoPath}`, {
      headers: {
        Accept: 'application/vnd.github+json',
        ...(token ? { Authorization: `Bearer ${token}` } : {}),
      },
    });
    if (res.ok) {
      const d = await res.json();
      if (d.stargazers_count > 0 || d.forks_count > 0) {
        repoStats = { stars: d.stargazers_count, forks: d.forks_count };
      }
    }
  } catch { /* rate limited or offline — show nothing rather than a stale number */ }
}

// The first link is the primary button: the live demo when there is one, else the source.
const links = [
  item.data.demo && { href: item.data.demo, label: 'Live demo', external: true },
  item.data.github && { href: item.data.github, label: 'GitHub', external: true },
  item.data.post && { href: `/blog/${item.data.post.id}/`, label: 'Read the write-up', external: false },
].filter((link) => !!link);

const primaryButton = 'bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 hover:opacity-90 transition-opacity';
const secondaryButton = 'border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors';
// The stills are 840x560 and show at their design size, 420px wide. Lazy loading keeps the browser from fetching the still of the other theme.
const still = { alt: '', width: 840, height: 560, loading: 'lazy', decoding: 'async' } as const;

const portfolioSchema = {
  "@context": "https://schema.org",
  "@type": item.data.github ? "SoftwareSourceCode" : "CreativeWork",
  "name": item.data.title,
  "description": item.data.description,
  "dateCreated": item.data.date ? item.data.date.toISOString() : undefined,
  "creator": { "@id": "https://mangeshbide.tech/#person" },
  "url": `https://mangeshbide.tech/portfolio/${item.id}`,
  "keywords": item.data.tech ? item.data.tech.join(", ") : undefined,
  "image": item.data.image ? `https://mangeshbide.tech${item.data.image}` : undefined,
  "codeRepository": item.data.github ? item.data.github : undefined
};
---

<Layout title={`${item.data.title} - Portfolio`} description={item.data.description} schema={portfolioSchema}>
  <article class="max-w-4xl mx-auto px-4 py-12" data-pagefind-body>
    <header class:list={['mb-10', image && 'md:grid md:grid-cols-[minmax(0,1fr)_420px] md:gap-10 md:items-start']}>
      <div>
        <h1 class="text-4xl font-bold tracking-tight mb-4">{item.data.title}</h1>
        <p class:list={['inline-block mb-4 px-2.5 py-0.5 rounded-full text-xs font-medium', status.class]}>{status.label}</p>
        {item.data.description && (
          <p class:list={['text-gray-600 dark:text-gray-400 mb-6', image ? 'text-lg' : 'text-xl']}>{item.data.description}</p>
        )}
        {links.length > 0 && (
          <div class="flex flex-wrap gap-3 mb-6">
            {links.map((link, i) => (
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class:list={['inline-flex items-center px-4 py-2 rounded-lg font-medium', i === 0 ? primaryButton : secondaryButton]}
              >
                {link.label}
              </a>
            ))}
          </div>
        )}
        <div class="flex flex-wrap gap-x-4 gap-y-3 items-center text-sm text-gray-600 dark:text-gray-400">
          {item.data.date && (
            <time datetime={item.data.date.toISOString()}>
              {item.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
          )}
          {repoStats && (
            <a
              href={item.data.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors"
              title="Stars and forks on GitHub"
            >
              <span class="inline-flex items-center gap-1">
                <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"></path>
                </svg>
                {repoStats.stars}
              </span>
              <span class="inline-flex items-center gap-1">
                <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"></path>
                </svg>
                {repoStats.forks}
              </span>
            </a>
          )}
        </div>
        {item.data.tech && item.data.tech.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4">
            {item.data.tech.map((tech) => (
              <span class="text-xs bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 px-2 py-1 rounded-md font-medium">
                {tech}
              </span>
            ))}
          </div>
        )}
      </div>

      {image && (
        <div class="mt-8 md:mt-2 aspect-[3/2] overflow-hidden rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-100 dark:bg-gray-900 shadow-sm">
          <img src={image} {...still} class:list={['w-full h-full object-cover', imageDark && 'dark:hidden']} />
          {imageDark && <img src={imageDark} {...still} class="w-full h-full object-cover hidden dark:block" />}
        </div>
      )}
    </header>

    <div class="prose prose-lg dark:prose-invert max-w-none">
      <Content />
    </div>

    <div class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
      <a
        href="/portfolio/"
        class="inline-flex items-center text-emerald-700 dark:text-emerald-400 hover:underline"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to portfolio
      </a>
    </div>
  </article>

  <script is:inline type="module">
    document.addEventListener('DOMContentLoaded', async () => {
      const mermaidElements = document.querySelectorAll('pre[data-language="mermaid"]');
      if (mermaidElements.length > 0) {
        const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs');
        mermaid.initialize({
          startOnLoad: false,
          theme: document.documentElement.classList.contains('dark') ? 'dark' : 'neutral'
        });

        for (const pre of mermaidElements) {
          const content = pre.textContent || '';
          const div = document.createElement('div');
          div.className = 'mermaid flex justify-center my-8 p-4 bg-white/50 dark:bg-gray-800/50 rounded-xl overflow-x-auto border border-gray-100 dark:border-gray-700';
          div.textContent = content;
          pre.replaceWith(div);
        }

        await mermaid.run({ querySelector: '.mermaid' });
      }
    });
  </script>

</Layout>
