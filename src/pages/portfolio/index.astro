---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

// Get all portfolio items from the content collection
const allProjects = (await getCollection('portfolio')).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

// Split so current work leads and older learning projects read as archive, not as current output
const groups = [
  {
    title: 'Selected work',
    blurb: 'What I build and ship, most of it self-initiated — backend services, AI and agent tooling, and the infrastructure they run on. Source is on GitHub for all of them, and the ones still hosted are linked live.',
    items: allProjects.filter((project) => project.data.featured),
  },
  {
    title: 'Earlier work',
    blurb: 'Older projects from while I was learning the stack. Kept for the record.',
    items: allProjects.filter((project) => !project.data.featured),
  },
].filter((group) => group.items.length > 0);
---

<Layout title="Portfolio | Mangesh Bide" description="Projects I've built — apps, APIs, and tools.">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="mb-12">
      <h1 class="text-4xl font-bold mb-4">Work</h1>
      <p class="text-gray-600 dark:text-gray-400 mb-6 max-w-2xl">
        Backend systems, AI and agent tooling, and infrastructure — most with source on GitHub and a live
        deployment you can poke at. Most representative work first.
      </p>
      

    </div>

    {groups.map((group) => (
    <section class="mb-16">
      <h2 class="text-2xl font-bold mb-2">{group.title}</h2>
      <p class="text-gray-600 dark:text-gray-400 mb-6 max-w-2xl">{group.blurb}</p>
      <div class="grid gap-8 md:grid-cols-2">
      {group.items.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
    ))}
  </div>
</Layout> 