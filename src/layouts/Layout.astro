---
import { siteConfig } from '../config/site';
import { identity } from '../data/identity';
import BackToTop from '../components/BackToTop.astro';
import Haptics from '../components/Haptics.astro';
import AiChat from '../components/AiChat.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  schema?: Record<string, any> | Record<string, any>[];
}

const { 
  title, 
  description = `${identity.headline}. ${identity.tagline}`,
  image = "/og-image.png",
  canonical,
  noindex = false,
  schema
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, siteConfig.url);
const imageURL = new URL(image, siteConfig.url);

// Secondary pages, grouped. The misc pages are listed on /fun instead of here.
const moreGroups = [
  { label: 'Notes', links: [['/now', 'Now'], ['/uses', 'My Stack'], ['/til', 'TIL'], ['/snippets', 'Snippets'], ['/bookmarks', 'Bookmarks'], ['/books', 'Books'], ['/resources', 'Resources']] },
  { label: 'Play', links: [['/playground', 'Playground'], ['/games', 'Games'], ['/earth-observatory', 'Earth Observatory'], ['/terminal', 'Terminal'], ['/wall', 'The Wall'], ['/tools', 'Dev Tools']] },
  { label: 'Misc', links: [['/fun', 'Fun & Life']] },
];

// The chat sits on the pages where visitors size up the person; playful widgets live on /fun.
const showChat = ['/', '/about', '/resume', '/contact'].includes(Astro.url.pathname.replace(/(.)\/$/, '$1'));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Mangesh's Blog" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={identity.name} />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    
    <!-- Robots -->
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:logo" content={new URL('/me.jpg', siteConfig.url)} />
    <meta property="og:site_name" content={siteConfig.title} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageURL} />
    <meta property="twitter:image:width" content="1200" />
    <meta property="twitter:image:height" content="630" />
    <meta property="twitter:creator" content="@Mangesh_Bide" />
    
    <!-- Additional SEO -->
    <meta name="theme-color" content="#3b82f6" />
    
    <!-- Content Security Policy for GoatCounter -->
    <meta http-equiv="Content-Security-Policy" content="font-src 'self' https://gc.zgo.at https://static.zgo.at data:; style-src 'self' 'unsafe-inline' https://gc.zgo.at https://static.zgo.at https://giscus.app;" />
    
    <!-- LinkedIn specific -->
    <meta property="article:author" content={identity.name} />
    <meta name="image" content={imageURL} />
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify((() => {
      const isHomePage = Astro.url.pathname === '/';
      
      const personSchema = {
        "@context": "https://schema.org",
        "@type": "Person",
        "@id": "https://mangeshbide.tech/#person",
        "name": identity.name,
        "url": "https://mangeshbide.tech",
        "image": "https://mangeshbide.tech/og-image.png",
        "photo": "https://mangeshbide.tech/me.jpg",
        "jobTitle": identity.headline,
        "worksFor": {
          "@type": "Organization",
          "name": identity.employer,
          "url": identity.employerUrl
        },
        "alumniOf": "https://www.rcpit.ac.in",
        // The topic list answer engines bind this entity to, so it tracks what is
        // actually published here and on the resume — not an aspirational stack.
        "knowsAbout": [
          "Keycloak", "SpiceDB", "Relationship-based access control", "Multi-tenant SaaS architecture",
          "Python", "Django", "TypeScript", "PostgreSQL", "Cloudflare Workers", "Astro", "AWS"
        ],
        "sameAs": [identity.links.github, identity.links.x, identity.links.linkedin]
      };

      const websiteSchema = {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://mangeshbide.tech/#website",
        "url": "https://mangeshbide.tech/",
        "name": "Mangesh Bide",
        "publisher": { "@id": "https://mangeshbide.tech/#person" },
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://mangeshbide.tech/search?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      };

      const baseSchemas = [websiteSchema, personSchema];
      
      if (!isHomePage) {
        const paths = Astro.url.pathname.split('/').filter(Boolean);
        if (paths.length > 0) {
          const breadcrumbSchema = {
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "https://mangeshbide.tech/"
              }
            ]
          };
          
          let currentPath = "https://mangeshbide.tech";
          paths.forEach((path, index) => {
            currentPath += `/${path}`;
            breadcrumbSchema.itemListElement.push({
              "@type": "ListItem",
              "position": index + 2,
              "name": path.charAt(0).toUpperCase() + path.slice(1).replace(/-/g, ' '),
              "item": currentPath + (index === paths.length - 1 && !currentPath.endsWith('/') ? '/' : '')
            });
          });
          baseSchemas.push(breadcrumbSchema as any);
        }
      }

      if (schema) {
        if (Array.isArray(schema)) {
          baseSchemas.push(...schema);
        } else {
          baseSchemas.push(schema as any);
        }
      }

      return baseSchemas;
    })())} />
    
    <!-- Animation Styles (loaded synchronously to prevent FOUC) -->
    <link rel="stylesheet" href="/animations.css">

    <!-- GoatCounter Analytics (deferred to not block rendering) -->
    <script data-goatcounter="https://mangeshbide.goatcounter.com/count"
        defer src="https://gc.zgo.at/count.js"></script>
    
    <style is:global>
      body {
        background-color: #ffffff;
        background-image: radial-gradient(rgba(0, 0, 0, 0.07) 1.5px, transparent 1.5px);
        background-size: 28px 28px;
        background-position: 0 0, 14px 14px;
      }
      html.dark body {
        background-color: #0b0f1a;
        background-image: radial-gradient(rgba(0, 229, 255, 0.04) 1.5px, transparent 1.5px);
      }
    </style>
  </head>
  <body class="bg-white dark:bg-[#0b0f1a] text-gray-900 dark:text-gray-100 transition-colors duration-300">
    <!-- Reading Progress Bar -->
    <div 
      id="reading-progress" 
      class="fixed top-0 left-0 h-1 custom-gradient-bg z-50 transition-all duration-300"
      style="width: 0%"
    ></div>
    
    <div class="min-h-screen flex flex-col page-enter">
      <header 
        id="navbar"
        class="border-b border-gray-200 dark:border-gray-700/50 bg-white dark:bg-[#0b0f1a] transition-all duration-300 sticky top-0 z-40 backdrop-blur-sm bg-opacity-90 dark:bg-opacity-90"
      >
        <nav class="max-w-4xl mx-auto px-4 py-6">
          <!-- Desktop Navigation -->
          <div class="flex justify-between items-center">
            <div class="flex items-center space-x-8">
              <a href="/" class="text-xl font-bold hover:text-emerald-700 dark:hover:text-cyan-400 transition-colors nav-link load-animate slide-left">
                by mangesh
              </a>
              <div class="hidden md:flex space-x-6">
                <a href="/portfolio" class="hover:text-emerald-700 dark:hover:text-cyan-400 transition-colors nav-link load-animate stagger-1">Work</a>
                <a href="/blog" class="hover:text-emerald-700 dark:hover:text-cyan-400 transition-colors nav-link load-animate stagger-2">Writing</a>
                <a href="/about" class="hover:text-emerald-700 dark:hover:text-cyan-400 transition-colors nav-link load-animate stagger-3">About</a>
                <a href="/resume" class="hover:text-emerald-700 dark:hover:text-cyan-400 transition-colors nav-link load-animate stagger-4">Resume</a>
                <a href="/contact" class="hover:text-emerald-700 dark:hover:text-cyan-400 transition-colors nav-link load-animate stagger-5">Contact</a>

                <!-- More Dropdown -->
                <div class="relative group load-animate stagger-5">
                  <button class="hover:text-emerald-700 dark:hover:text-cyan-400 transition-colors flex items-center nav-link">
                    More
                    <svg class="ml-1 w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </button>
                  <div class="absolute right-0 mt-2 w-[34rem] bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50 hover-lift">
                    <div class="grid grid-cols-3 gap-x-2 py-2">
                      {moreGroups.map((group) => (
                        <div>
                          <div class="px-4 pt-2 pb-1 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">{group.label}</div>
                          {group.links.map(([href, label]) => (
                            <a href={href} class="block px-4 py-2 text-sm hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-emerald-700 dark:hover:text-cyan-400 transition-colors">{label}</a>
                          ))}
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="flex items-center space-x-2">
              <a href="/search" class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300 hover-lift load-animate slide-right" aria-label="Search">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </a>
              <button
                id="theme-toggle"
                data-haptic="selection"
                class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300 theme-toggle load-animate slide-right stagger-1"
                aria-label="Toggle theme"
              >
                <svg class="w-5 h-5 hidden dark:block" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"></path>
                </svg>
                <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                </svg>
              </button>
              <button
                id="mobile-menu-btn"
                data-haptic="light"
                class="md:hidden p-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors hover-lift"
                aria-label="Toggle mobile menu"
              >
                <svg id="menu-open-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
                <svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          </div>

          <!-- Mobile Menu -->
          <div id="mobile-menu" class="hidden md:hidden mt-4 mobile-menu-enter">
            <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4 border border-gray-200 dark:border-gray-700 shadow-lg hover-lift">
              <!-- Primary -->
              <a href="/portfolio" class="block px-3 py-2 rounded-md text-base font-medium hover:text-emerald-700 dark:hover:text-cyan-400 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                Work
              </a>
              <a href="/blog" class="block px-3 py-2 rounded-md text-base font-medium hover:text-emerald-700 dark:hover:text-cyan-400 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                Writing
              </a>
              <a href="/about" class="block px-3 py-2 rounded-md text-base font-medium hover:text-emerald-700 dark:hover:text-cyan-400 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                About
              </a>
              <a href="/resume" class="block px-3 py-2 rounded-md text-base font-medium hover:text-emerald-700 dark:hover:text-cyan-400 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                Resume
              </a>
              <a href="/contact" class="block px-3 py-2 rounded-md text-base font-medium hover:text-emerald-700 dark:hover:text-cyan-400 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                Contact
              </a>

              {moreGroups.map((group) => (
                <>
                  <div class="px-3 py-1 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mt-4">{group.label}</div>
                  {group.links.map(([href, label]) => (
                    <a href={href} class="block px-6 py-2 rounded-md text-base font-medium hover:text-emerald-700 dark:hover:text-cyan-400 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">{label}</a>
                  ))}
                </>
              ))}
            </div>
          </div>
        </nav>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="border-t border-gray-200 dark:border-gray-700 mt-16 animate-on-scroll">
        <div class="max-w-4xl mx-auto px-4 py-8 text-center text-gray-600 dark:text-gray-400">
          <nav class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm mb-6">
            <a href="/portfolio" class="hover:text-emerald-700 dark:hover:text-cyan-400 transition-colors">Work</a>
            <a href="/blog" class="hover:text-emerald-700 dark:hover:text-cyan-400 transition-colors">Writing</a>
            <a href="/about" class="hover:text-emerald-700 dark:hover:text-cyan-400 transition-colors">About</a>
            <a href="/resume" class="hover:text-emerald-700 dark:hover:text-cyan-400 transition-colors">Resume</a>
            <a href="/contact" class="hover:text-emerald-700 dark:hover:text-cyan-400 transition-colors">Contact</a>
            <a href="/playground" class="hover:text-emerald-700 dark:hover:text-cyan-400 transition-colors">Playground</a>
            <a href="/rss.xml" class="hover:text-emerald-700 dark:hover:text-cyan-400 transition-colors">RSS</a>
          </nav>
          <p>Built with ❤️ by <a href="https://github.com/1mangesh1" class="text-blue-600 dark:text-cyan-400 hover:underline link-glow">Mangesh</a> using <a href="https://astro.build" class="text-blue-600 dark:text-cyan-400 hover:underline link-glow">Astro</a> & <a href="https://tailwindcss.com" class="text-blue-600 dark:text-cyan-400 hover:underline link-glow">Tailwind CSS</a></p>
        </div>
      </footer>
    </div>

    <!-- Back to Top Button -->
    <BackToTop />

    <script>
      // Theme toggle functionality with enhanced animation
      const themeToggle = document.getElementById('theme-toggle');
      const html = document.documentElement;

      // Saved choice wins; otherwise follow the OS setting rather than forcing light
      const storedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

      if (storedTheme === 'dark' || (!storedTheme && prefersDark)) {
        html.classList.add('dark');
      }

      themeToggle?.addEventListener('click', () => {
        html.classList.toggle('dark');
        const isDark = html.classList.contains('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        
        // Add a little bounce effect
        themeToggle.style.transform = 'scale(0.95)';
        setTimeout(() => {
          themeToggle.style.transform = '';
        }, 150);
      });

      // Enhanced mobile menu functionality
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const menuOpenIcon = document.getElementById('menu-open-icon');
      const menuCloseIcon = document.getElementById('menu-close-icon');
      
      mobileMenuBtn?.addEventListener('click', () => {
        const isHidden = mobileMenu?.classList.contains('hidden');
        
        if (isHidden) {
          mobileMenu?.classList.remove('hidden');
          mobileMenu?.classList.add('mobile-menu-enter');
          menuOpenIcon?.classList.add('hidden');
          menuCloseIcon?.classList.remove('hidden');
        } else {
          mobileMenu?.classList.add('hidden');
          mobileMenu?.classList.remove('mobile-menu-enter');
          menuOpenIcon?.classList.remove('hidden');
          menuCloseIcon?.classList.add('hidden');
        }
      });

      // Close mobile menu when clicking on a link
      const mobileMenuLinks = mobileMenu?.querySelectorAll('a');
      mobileMenuLinks?.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu?.classList.add('hidden');
          mobileMenu?.classList.remove('mobile-menu-enter');
          menuOpenIcon?.classList.remove('hidden');
          menuCloseIcon?.classList.add('hidden');
        });
      });

      // Close mobile menu when clicking outside
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!mobileMenu?.contains(target) && !mobileMenuBtn?.contains(target)) {
          mobileMenu?.classList.add('hidden');
          mobileMenu?.classList.remove('mobile-menu-enter');
          menuOpenIcon?.classList.remove('hidden');
          menuCloseIcon?.classList.add('hidden');
        }
      });

      // Enhanced reading progress and navbar scroll behavior
      const readingProgress = document.getElementById('reading-progress');
      const navbar = document.getElementById('navbar');
      let lastScrollY = window.scrollY;
      let ticking = false;

      const updateProgress = () => {
        const scrollTop = window.scrollY;
        const windowHeight = window.innerHeight;
        const documentHeight = document.documentElement.scrollHeight;
        
        // Calculate reading progress
        const progress = Math.min(100, Math.max(0, (scrollTop / (documentHeight - windowHeight)) * 100));
        
        if (readingProgress) {
          readingProgress.style.width = `${progress}%`;
        }

        // Enhanced navbar hide/show on scroll with backdrop blur
        if (navbar) {
          const scrollingDown = scrollTop > lastScrollY;
          const scrolledPastThreshold = scrollTop > 100;
          
          if (scrollingDown && scrolledPastThreshold) {
            // Hide navbar when scrolling down
            navbar.style.transform = 'translateY(-100%)';
          } else {
            // Show navbar when scrolling up or at top
            navbar.style.transform = 'translateY(0)';
          }
          
          // Add backdrop blur when scrolled
          if (scrollTop > 20) {
            navbar.classList.add('backdrop-blur-md');
          } else {
            navbar.classList.remove('backdrop-blur-md');
          }
        }
        
        lastScrollY = scrollTop;
        ticking = false;
      };

      const handleScroll = () => {
        if (!ticking) {
          requestAnimationFrame(updateProgress);
          ticking = true;
        }
      };

      // Intersection Observer for scroll animations
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            // Optional: unobserve after animation to improve performance
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      // Observe all elements with animate-on-scroll class
      const animateElements = document.querySelectorAll('.animate-on-scroll');
      animateElements.forEach(el => observer.observe(el));

      // Add stagger delay to elements in containers
      const staggerContainers = document.querySelectorAll('[data-stagger]');
      staggerContainers.forEach(container => {
        const children = container.children;
        Array.from(children).forEach((child, index) => {
          (child as HTMLElement).style.animationDelay = `${index * 0.1}s`;
        });
      });

      window.addEventListener('scroll', handleScroll);
      
      // Initial update
      updateProgress();
    </script>
    <!-- Living Site disabled — KV free tier limit hit. Uncomment to re-enable. -->
    <!-- <script async src="/living-site.js" is:inline></script> -->
    <Haptics />
    {showChat && <AiChat />}
  </body>
</html> 